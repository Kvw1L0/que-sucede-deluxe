{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/game.mjs": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/play", "destination": "/index.html" },
    { "source": "/tv", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/host/:code", "destination": "/index.html" },
    { "source": "/screen/:code", "destination": "/index.html" },
    { "source": "/j/:code", "destination": "/index.html" }
  ]
}
